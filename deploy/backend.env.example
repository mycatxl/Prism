# Environment configuration for Prism backend.
# Copy as .env into the backend working directory, or set process/container env.
# Generate TWO independent values, for example: openssl rand -hex 32
PRISM_ADMIN_TOKEN=replace-with-your-random-admin-token
PRISM_PROXY_TOKEN=replace-with-your-random-proxy-token

# Management panel listens on this address (default 127.0.0.1:2260).
PRISM_LISTEN_ADDRESS=127.0.0.1
PRISM_PORT=2260

# Optional independent management listener "host:port"; an empty value disables
# it. It serves only /ui, /api and /healthz, never a proxy protocol, which makes
# it convenient for exposing the management plane on an internal interface.
# PRISM_ADMIN_LISTEN=127.0.0.1:2261

# Relative to the backend working directory.
PRISM_STATE_DIR=./data/state
PRISM_CACHE_DIR=./data/cache
PRISM_LOG_DIR=./data/logs

# Start conservatively and tune for the host and upstream service limits.
PRISM_PROBE_CONCURRENCY=32
PRISM_PROBE_TIMEOUT=15s

# Optional security switches (defaults keep the upstream behaviour).
# CIDRs whose X-Forwarded-For is trusted for the management API login failure
# limit. Empty means "trust no proxy".
# PRISM_TRUSTED_PROXIES=10.0.0.0/8
# Refuse loopback/private/link-local targets on the local direct bypass path.
# PRISM_DIRECT_DENY_PRIVATE=false
# Failure limit for the proxy entry points; 0 disables it.
# PRISM_PROXY_AUTH_FAIL_LIMIT=0
