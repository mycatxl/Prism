# Environment configuration for the Prism backend (production reference).
# Copy as .env into the backend working directory, or set process/container env.
# Run `prism init` first: it creates the administrator account and the password
# pepper. Generate the proxy token yourself, for example: openssl rand -hex 32
# Every line is optional except the ones marked required; the value shown is the
# one that applies when the line is absent (a line left empty counts as absent).
PRISM_PROXY_TOKEN=replace-with-your-random-proxy-token

# --- paths (relative to the backend working directory) ---
PRISM_STATE_DIR=./data/state
PRISM_CACHE_DIR=./data/cache
PRISM_LOG_DIR=./data/logs

# --- listener ---
# Management panel, API and every proxy protocol share this address
# (default 127.0.0.1:2260).
PRISM_LISTEN_ADDRESS=127.0.0.1
PRISM_PORT=2260
# Optional independent management listener "host:port"; an empty value disables
# it. It serves only /ui, /api and /healthz, never a proxy protocol, which makes
# it convenient for exposing the management plane on an internal interface.
# PRISM_ADMIN_LISTEN=127.0.0.1:2261
# Request body ceiling of the management API, in bytes (default 1 MiB).
# PRISM_API_MAX_BODY_BYTES=1048576

# --- credentials and startup policy ---
# Accepted protocol version; V1 is the only value (default V1).
# PRISM_AUTH_VERSION=V1
# Password pepper (default: the `pepper` file in PRISM_STATE_DIR). Overriding it
# invalidates every password and access key created under the file's pepper.
# PRISM_KEY_PEPPER=
# Reject weak proxy tokens (shorter than 16 characters, default true).
# PRISM_ENFORCE_STRONG_TOKENS=true
# Allow an empty proxy token (proxy authentication off; default false).
# PRISM_ALLOW_EMPTY_PROXY_TOKEN=false
# Allow a non-loopback listener while the proxy token is empty (default false).
# PRISM_ALLOW_INSECURE_LISTEN=false
# Require a second factor for administrator accounts (default false).
# PRISM_REQUIRE_ADMIN_TOTP=false
# Failure limit per source IP on the proxy entry points; 0 disables it
# (default 30).
# PRISM_PROXY_AUTH_FAIL_LIMIT=30

# --- trusted proxies ---
# CIDRs whose X-Forwarded-For is trusted for the management API login failure
# limit, and whose X-Forwarded-Proto: https is accepted as the transport the
# client really used. A deployment that terminates TLS at a reverse proxy lists
# that proxy here, otherwise Prism sees plaintext HTTP and issues the session
# cookie (prism_session) only on a loopback plaintext request. Empty means
# "trust no proxy"; the rightmost header value wins.
# PRISM_TRUSTED_PROXIES=10.0.0.0/8

# --- SSRF and abuse guards ---
# Refuse loopback/private/link-local/CGNAT/reserved/metadata targets on every
# local direct dial path (reverse-proxy bypass, forward HTTP, CONNECT, SOCKS5);
# node-routed requests are unaffected (default true).
# PRISM_DIRECT_DENY_PRIVATE=true
# Destination ports refused on every local direct dial path, comma separated.
# The default blocks the SMTP ports, so an exposed deployment is not an outbound
# mail relay; an empty value allows every port. Independent of
# PRISM_DIRECT_DENY_PRIVATE: turning that off does not reopen these ports.
# PRISM_BLOCKED_DESTINATION_PORTS=25,465,587
# Refuse a node whose own server names resolve to loopback, the LAN, a
# link-local address or a cloud metadata endpoint (default true).
# PRISM_DENY_PRIVATE_NODES=true
# Hosts and CIDRs the proxy never forwards through a node; comma separated
# (default empty).
# PRISM_PROXY_BYPASS=

# --- self-service registration ---
# off (default) | invite | open. The console's Settings -> Account Registration
# can override this at runtime; this value is what a cleared override falls
# back to.
# PRISM_REGISTRATION=off

# --- USDT deposits (TRC20) ---
# The address that receives deposits. It is your own wallet; the server only
# reads the chain and holds no key. Leave it empty to keep on-chain deposits off,
# which leaves the rest of the deployment working.
#
# The contract is Tether's TRC20 USDT and the endpoint is TronGrid, whose V1
# account API returns already-decoded Transfer events. The API key is optional
# but TronGrid rate-limits anonymous callers hard enough that a poller needs one.
# Defaults: contract TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t,
#           endpoint https://api.trongrid.io
# PRISM_USDT_ADDRESS=
# PRISM_USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
# PRISM_TRONGRID_ENDPOINT=https://api.trongrid.io
# PRISM_TRONGRID_API_KEY=

# --- usage anomaly alerts ---
# Report an account that spends this share of its plan quota (0 < ratio <= 1)
# inside this many minutes, and keep the report for this many days (>= 1).
# Defaults: 0.3 / 60 / 90.
#
# The scanner re-reads the three on every pass (once a minute), so a change made
# in the console is in force at the next scan. A variable with a value pins the
# setting at every start and overrides the persisted one; leave it out (or
# empty) to keep what the console saved. An out-of-range value refuses the
# start.
# PRISM_ALERT_USAGE_RATIO=0.3
# PRISM_ALERT_WINDOW_MINUTES=60
# PRISM_ALERT_RETENTION_DAYS=90

# --- probes and resource downloads ---
# Start conservatively and tune for the host and upstream service limits.
# PRISM_PROBE_CONCURRENCY=32
# PRISM_PROBE_TIMEOUT=15s
# PRISM_MAX_LATENCY_TABLE_ENTRIES=12
# PRISM_GEOIP_UPDATE_SCHEDULE=0 7 * * *
# Node egress probe target; empty keeps the persisted value or the shipped
# default (https://cloudflare.com/cdn-cgi/trace).
# PRISM_EGRESS_TRACE_URL=
# PRISM_RESOURCE_FETCH_TIMEOUT=30s
# Allow subscription/resource downloads to reach loopback and private addresses
# (default false).
# PRISM_RESOURCE_FETCH_ALLOW_PRIVATE=false
# Download ceiling after HTTP decompression, in bytes (default 32 MiB).
# PRISM_RESOURCE_FETCH_MAX_BYTES=33554432
# DNS upstreams for node name resolution, as a JSON array.
# PRISM_NODE_DNS_UPSTREAMS=["https://doh.pub/dns-query","https://dns.alidns.com/dns-query","tls://223.5.5.5?sni=dns.alidns.com","local"]

# --- outbound transport (defaults) ---
# PRISM_PROXY_TRANSPORT_MAX_IDLE_CONNS=1024
# PRISM_PROXY_TRANSPORT_MAX_IDLE_CONNS_PER_HOST=64
# PRISM_PROXY_TRANSPORT_IDLE_CONN_TIMEOUT=90s
# PRISM_PROXY_TRANSPORT_RESPONSE_HEADER_TIMEOUT=60s
# PRISM_PROXY_TRANSPORT_TLS_HANDSHAKE_TIMEOUT=10s
# PRISM_PROXY_TRANSPORT_DIAL_TIMEOUT=30s
# Upper bound on concurrently active endpoint nodes (default 256). A lease that
# would exceed it fails with ENDPOINT_LIMIT instead of growing without a limit.
# PRISM_MAX_ENDPOINTS=256

# --- default platform settings ---
# PRISM_DEFAULT_PLATFORM_STICKY_TTL=168h
# PRISM_DEFAULT_PLATFORM_REGEX_FILTERS=[]
# PRISM_DEFAULT_PLATFORM_REGION_FILTERS=[]
# PRISM_DEFAULT_PLATFORM_REVERSE_PROXY_MISS_ACTION=TREAT_AS_EMPTY
# PRISM_DEFAULT_PLATFORM_REVERSE_PROXY_EMPTY_ACCOUNT_BEHAVIOR=ACCOUNT_HEADER_RULE
# PRISM_DEFAULT_PLATFORM_REVERSE_PROXY_FIXED_ACCOUNT_HEADER=Authorization
# PRISM_DEFAULT_PLATFORM_ALLOCATION_POLICY=BALANCED

# --- request log ---
# PRISM_REQUEST_LOG_QUEUE_SIZE=8192
# PRISM_REQUEST_LOG_QUEUE_FLUSH_BATCH_SIZE=4096
# PRISM_REQUEST_LOG_QUEUE_FLUSH_INTERVAL=5m
# PRISM_REQUEST_LOG_DB_MAX_MB=512
# PRISM_REQUEST_LOG_DB_RETAIN_COUNT=2
# The queue size must be at least twice the flush batch size.

# --- metrics ---
# PRISM_METRIC_THROUGHPUT_INTERVAL_SECONDS=2
# PRISM_METRIC_THROUGHPUT_RETENTION_SECONDS=3600
# PRISM_METRIC_BUCKET_SECONDS=3600
# PRISM_METRIC_CONNECTIONS_INTERVAL_SECONDS=15
# PRISM_METRIC_CONNECTIONS_RETENTION_SECONDS=18000
# PRISM_METRIC_LEASES_INTERVAL_SECONDS=5
# PRISM_METRIC_LEASES_RETENTION_SECONDS=18000
# PRISM_METRIC_LATENCY_BIN_WIDTH_MS=100
# PRISM_METRIC_LATENCY_BIN_OVERFLOW_MS=3000

# --- exit quality ---
# Independent from health probes. Free public mode works without a key: 80
# lookups a day, or 900 a day with a free ProxyCheck key.
# PRISM_QUALITY_ENABLED, PRISM_QUALITY_WORKERS and PRISM_QUALITY_QUEUE_SIZE are
# deprecated and ignored: intel_enabled decides whether the quality jobs run and
# intel_node_workers sizes the pool. Setting any of them only logs a warning.
# PRISM_QUALITY_API_KEY=
# PRISM_QUALITY_DAILY_LIMIT=80
# Optional free AbuseIPDB account; separate allowance 900/day.
# PRISM_ABUSEIPDB_API_KEY=

# --- other exit-quality data sources (no console page: set them here) ---
# IPQualityScore and ipapi.is take an API key; the two GeoIP databases take the
# download credentials of their vendor. An empty value leaves that source off.
# PRISM_IPQS_API_KEY=
# PRISM_IPAPI_IS_API_KEY=
# MaxMind GeoLite2 needs an account id and a license key.
# PRISM_MAXMIND_ACCOUNT_ID=
# PRISM_MAXMIND_LICENSE_KEY=
# IPinfo Lite needs a token.
# PRISM_IPINFO_TOKEN=
