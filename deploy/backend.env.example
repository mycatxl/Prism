# Environment for the existing Resin backend, not the frontend process.
# Copy as .env into the backend working directory, or set process/container env.
# Generate TWO independent values, for example: openssl rand -hex 32
RESIN_ADMIN_TOKEN=replace-with-your-random-admin-token
RESIN_PROXY_TOKEN=replace-with-your-random-proxy-token

# Separate from the management panel on 127.0.0.1:1262.
RESIN_LISTEN_ADDRESS=127.0.0.1
RESIN_PORT=2260

# Relative to the backend working directory.
RESIN_STATE_DIR=./data/state
RESIN_CACHE_DIR=./data/cache
RESIN_LOG_DIR=./data/logs

# Start conservatively and tune for the host and upstream service limits.
RESIN_PROBE_CONCURRENCY=32
RESIN_PROBE_TIMEOUT=15s
