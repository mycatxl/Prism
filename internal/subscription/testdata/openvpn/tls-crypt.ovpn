# Prism OpenVPN fixture: tls-crypt, inline ca/cert/key, single remote.
client
dev tun
proto udp
remote vpn.example.com 1194
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
auth SHA256
data-ciphers AES-256-GCM:AES-128-GCM:CHACHA20-POLY1305
data-ciphers-fallback AES-256-CBC
tls-version-min 1.2
reneg-sec 3600
keepalive 10 60
verb 3
