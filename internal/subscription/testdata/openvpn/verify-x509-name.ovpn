# Prism OpenVPN fixture: verify-x509-name with the default (subject) type and
# a peer fingerprint instead of a CA bundle.
client
dev tun
proto udp
remote vpn.example.com 1194
verify-x509-name prism.example.com
peer-fingerprint 0011223344556677889900112233445566778899001122334455667788990011
tun-mtu 1400
mssfix 1300
fragment 1200
