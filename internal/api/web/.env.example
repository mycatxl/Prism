# Management panel. Both npm run dev and npm start read these variables.
PRISM_UI_HOST=127.0.0.1
PRISM_UI_PORT=1262

# Private backend origin, NOT the management panel. Never include a token here.
PRISM_API_TARGET=http://127.0.0.1:2260

# Optional public proxy endpoint for address generation (build-time setting).
# This is not a secret. It can also be changed in the platform access view.
# VITE_PROXY_BASE_URL=http://127.0.0.1:2260

# Never put administrator/proxy tokens in VITE_* variables: Vite exposes them
# to browsers. Backend tokens belong to the backend environment instead.
