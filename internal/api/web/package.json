{
  "name": "prism-webui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "node scripts/start.mjs",
    "test:config": "node --test tests/design-tokens.test.mjs tests/config.test.mjs tests/request-limit.test.mjs tests/intel-scope.test.mjs tests/platform-criteria.test.mjs tests/kit.test.mjs tests/i18n-coverage.test.mjs tests/plan-units.test.mjs",
    "test:e2e": "node scripts/check-ui-live.mjs",
    "prep:world-map": "node scripts/build-world-map.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "check:types": "tsc -p tsconfig.app.json --noEmit",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:kit": "node scripts/check-kit.mjs",
    "check:responsive": "node scripts/check-responsive.mjs",
    "check:nav": "node scripts/check-navigation.mjs",
    "check:slop": "node scripts/check-slop.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@hookform/resolvers": "^5.2.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.90.21",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "framer-motion": "^12.34.2",
    "i18n-iso-countries": "^7.14.0",
    "i18next": "^25.8.13",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.1",
    "react-i18next": "^16.5.4",
    "react-router": "^7.18.2",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.63.0",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "topojson-client": "^3.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.3.5"
  }
}
