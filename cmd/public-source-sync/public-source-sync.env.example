# public-source-sync 配置模板
#
# 用法（任选一种）：
#   1. 复制成 `.env` 放到运行目录，直接启动，默认就会读它；
#   2. 复制到别处，用 PUBLIC_SOURCE_ENV_FILE=/path/to/file.env 指定；
#   3. 完全不落文件，用 systemd / docker / shell 导出这些环境变量。
#
# 真实环境变量永远优先于 .env 里的同名值，方便临时覆盖。
#
# 命名：目标实例是 Prism，所以指向它的两个变量用 PRISM_ 写法；上游 Resin 的
# 写法（PUBLIC_SOURCE_RESIN_URL / PUBLIC_SOURCE_RESIN_ADMIN_TOKEN）仍然接受，
# 老的 .env 不用改就能继续跑。

# ══════════════════════════════════════════════════════════════
#  必填：只需要你填这两项
# ══════════════════════════════════════════════════════════════

# 你已部署的 Prism 地址。http 或 https，不要带用户名密码，末尾不要加路径。
PUBLIC_SOURCE_PRISM_URL=http://127.0.0.1:2260

# Prism 的 PRISM_ADMIN_TOKEN，就是部署 Prism 时设的那个。
# 只需要 Admin Token，不需要 PRISM_PROXY_TOKEN。
# 这一项留空时会自动回退到共享的 PRISM_ADMIN_TOKEN（或它的旧写法
# RESIN_ADMIN_TOKEN），这样和 Prism 共用一个 .env 也能跑。
PUBLIC_SOURCE_PRISM_ADMIN_TOKEN=


# ══════════════════════════════════════════════════════════════
#  来源：内置预设（无需自己找链接）
# ══════════════════════════════════════════════════════════════
# 逗号分隔，可任意组合：
#   classic   历史上的单一默认来源（TheSpeedX HTTP）
#   http      HTTP/HTTPS 代理列表 · 22 个来源
#   socks     SOCKS4/SOCKS5 代理列表 · 12 个来源
#   nodes     节点订阅 vmess/vless/trojan/ss 等 · 13 个来源
#   all       以上全部 · 47 个唯一来源（自动去重）
#   none      不用任何静态来源，只跑 Gist 打野
#
# 预设里的每个 URL 都通过 TestPresetSourcesYieldNodes 实测过，
# 用 PUBLIC_SOURCE_LIVE_PRESET_TEST=1 go test ./internal/publicsource/ -run PresetSources -v 可以复验。
PUBLIC_SOURCE_PRESETS=all

# 额外自定义来源，JSON 数组，会追加在预设之后并自动去重。
# 支持纯文本 ip:port、协议 URI 行、base64 订阅、Clash / sing-box 配置。
PUBLIC_SOURCE_URLS=[]


# ══════════════════════════════════════════════════════════════
#  来源：GitHub Gist 打野
# ══════════════════════════════════════════════════════════════
# 方法：在 gist.github.com 搜节点协议链接 → 按 Recently updated 排序 →
#       抓每个命中 Gist 的正文 → 只提取代理节点 URI。
PUBLIC_SOURCE_GIST_ENABLED=true
PUBLIC_SOURCE_GIST_QUERIES=["vmess://","vless://","trojan://","ss://","hysteria2://"]
PUBLIC_SOURCE_GIST_MAX_PAGES=2
PUBLIC_SOURCE_GIST_MAX_GISTS=40
# 留空则等于同步周期，最短 5m
PUBLIC_SOURCE_GIST_CACHE_TTL=30m


# ══════════════════════════════════════════════════════════════
#  同步行为
# ══════════════════════════════════════════════════════════════

# 在目标 Prism 中创建/更新的本地订阅名。
# 在 Prism UI 里禁用这个订阅即可暂停同步，不会强制改回 enabled。
PUBLIC_SOURCE_SUBSCRIPTION_NAME=Public sources

# 采集周期，最短 30s。
PUBLIC_SOURCE_SYNC_INTERVAL=30m

# 单个来源的抓取 + 解析超时。
PUBLIC_SOURCE_FETCH_TIMEOUT=30s

# 推送到 Prism 的节点上限，0 表示不限制。
#
# 去重后的真实规模：all 预设一轮约 16.4 万条候选 → 约 12 万个唯一节点、
# 13.3 MiB 载荷、平均 115 字节/节点。
#
# 想全部导入就写 0，但要注意 Prism 的每节点成本约 6.6 KiB（每个节点都要建一个
# sing-box outbound）：1000 条约 7 MiB，20000 条约 130 MiB，12 万条约 828 MiB。
# 免费代理存活率本来就是个位数百分比，先按内存给一个值，用 Prism 的测活结果说话。
PUBLIC_SOURCE_MAX_NODES=1000

# 生成的订阅体积上限，必须小于 Prism 的 PRISM_API_MAX_BODY_BYTES（默认 1 MiB），
# 否则会被 413 PAYLOAD_TOO_LARGE 拒绝。900 * 1024 = 921600。
#
# 要全部导入，这一项和 Prism 侧都要放大：
#   PUBLIC_SOURCE_MAX_UPLOAD_BYTES=16777216
#   PRISM_API_MAX_BODY_BYTES=16777216
PUBLIC_SOURCE_MAX_UPLOAD_BYTES=921600


# ══════════════════════════════════════════════════════════════
#  订阅模式（对应 Prism 订阅的三个开关）
# ══════════════════════════════════════════════════════════════
# 创建订阅时会带上这三项；更新订阅时也会一并 PATCH，
# 所以已经存在的订阅不会一直卡在 Prism 的服务端默认值上
# （默认是 ephemeral=false、incremental_alive_nodes=false、驱逐延迟 72h）。

# 临时订阅：打开后 Prism 的清理器会定期扫描它，把失效节点标记驱逐。
# 默认 true —— 公开来源的存活率极低，不清理的话池子会被死节点塞满。
PUBLIC_SOURCE_EPHEMERAL=true

# 存活节点增量模式：刷新时保留"旧集合里仍健康"的节点，
# 与本次新内容做并集，而不是整批替换。
# 默认 true —— 一个能用的节点不该因为这一轮从免费列表里掉出去就被丢掉。
PUBLIC_SOURCE_INCREMENTAL_ALIVE_NODES=true

# 临时节点驱逐延迟：节点 circuit 打开（探测连续失败）超过这个时长就被驱逐。
# 用 Go duration 格式。默认 15m。
#
# ⚠️ 驱逐是永久的：被标记 Evicted 的 hash 即使之后重新出现在新内容里，
#    Prism 也会跳过它（subscription_scheduler.go 里明确写了不会加回池），
#    而且代码里没有任何把它置回 false 的路径。
#    所以这个值别设得太小：设成 15m 意味着"只要抽风 15 分钟就永久出局"。
#    公开免费列表里同一个 hash 反复出现，驱逐后会永久失效，
#    有效节点数会随着时间不断下降。想更保守就用 1h 或 2h。
PUBLIC_SOURCE_EPHEMERAL_EVICT_DELAY=15m

# 要读的配置文件路径，默认就是运行目录下的 .env。
# PUBLIC_SOURCE_ENV_FILE=.env


# ══════════════════════════════════════════════════════════════
#  拉取模式（可选，替代上面的推送模式）
# ══════════════════════════════════════════════════════════════
# 只要设了 PUBLIC_SOURCE_SERVE_ADDR，同步器就切换成"只提供内容"：
# 起一个 HTTP 端点，让 Prism 建远程订阅自己来拉。
# 这种情况下 PUBLIC_SOURCE_PRISM_URL 和 admin token 都不需要 ——
# 同步器完全不碰 Admin API，也就不需要给它任何 Prism 凭据。
#
# 然后在 Prism 里建一个 remote 订阅：
#   名字随意，URL = http://<同步器主机>:8787/sub，update_interval 建议 <= 同步周期
# 不填 source_type 时 Prism 默认就是 remote，所以 UI 里选远程/填 URL 即可。
#
# 前提：Prism 必须能访问到这个地址。
#   - 同机部署：PUBLIC_SOURCE_SERVE_ADDR=127.0.0.1:8787 就够了，最省事也最安全
#   - 跨机部署：要写成能被 Prism 访问到的地址，并确保防火墙放行
#
# 留空 = 用上面那套推送模式。
# PUBLIC_SOURCE_SERVE_ADDR=127.0.0.1:8787

# 端点路径。Prism 拉取时是裸 GET、不带任何请求头，
# 所以想加共享密钥只能藏在路径里，比如 /sub/8f3c1d9a2b。
# PUBLIC_SOURCE_SERVE_PATH=/sub