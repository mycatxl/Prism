# Build output
/bin/
/prism
/prism.exe
/subprobe
/subprobe.exe
*.test
*.out
coverage.*
*.coverprofile

# Local runtime data (repo root only)
/.local/
/state/
/data/
/backups/
*.db
*.db-shm
*.db-wal
*.log

# Secrets
.env
.env.local
.admin_token

# Frontend
node_modules/
/internal/api/web/dist/*
!/internal/api/web/dist/.gitkeep

# Local scratch: notes, plans and reference material stay on the machine that
# wrote them. This repository ships the code, the README, the licence and
# provenance files, and the operator guide - the README links
# docs/MULTI_TENANT.md, so docs/ is tracked and these three paths are not.
/notes/
/plans/
/references/

# Editors / OS
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# Go workspace
go.work
go.work.sum

# npm pack output and release archives
*.tgz

# Machine-local Impeccable state: the critique snapshots and detector config that
# the design skill writes next to the project. Useful on disk, never in the repo.
.impeccable/
