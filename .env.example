# Prism environment reference.
#
# Copy only when you do not already have a private .env: `./bin/prism init`
# writes one together with the administrator account, the password pepper and a
# random proxy token. Every line below is optional except the ones marked
# required; each setting shows the value that applies when the line is absent
# (a line left empty counts as absent).
#
# This file documents the environment. The console's settings page owns the
# retention windows (audit_retention_days, usage_retention_days), the purity
# bands and the alert settings while the process runs; a variable here pins its
# value at every start.
#
# The two retention windows have no variable here on purpose: a window of 0
# means "use the shipped window" - 90 days for the audit log, 400 for the usage
# day table - which is what a deployment that never touched the setting carries.
# It is not "keep everything".

# Required. Data-plane proxy token: `prism init` generates one. At least 16
# characters while PRISM_ENFORCE_STRONG_TOKENS is on.
PRISM_PROXY_TOKEN=replace-with-your-random-proxy-token

# --- paths (relative to the directory Prism is started in) ---
PRISM_STATE_DIR=./.local/state
PRISM_CACHE_DIR=./.local/cache
PRISM_LOG_DIR=./.local/logs

# --- listener ---
# Primary listener: WebUI, API, HTTP forward proxy, reverse proxy, SOCKS5 and
# token-action all share it. Defaults are 127.0.0.1:2260.
PRISM_LISTEN_ADDRESS=127.0.0.1
PRISM_PORT=2260
# Optional independent management listener "host:port"; an empty value disables
# it. It only serves /ui, /api and /healthz, never a proxy protocol.
# PRISM_ADMIN_LISTEN=127.0.0.1:2261
# Request body ceiling of the management API, in bytes (default 1 MiB).
# PRISM_API_MAX_BODY_BYTES=1048576

# --- credentials and startup policy ---
# Accepted protocol version; V1 is the only value (default V1).
# PRISM_AUTH_VERSION=V1
# Pin the password pepper of this deployment (default: the `pepper` file in
# PRISM_STATE_DIR, written by `prism init`). Setting this overrides that file,
# so every password and access key created under the old pepper stops
# verifying. Back the file up; do not paste the value into a deployment file
# you might lose.
# PRISM_KEY_PEPPER=
# Reject weak proxy tokens (shorter than 16 characters); false restores the
# upstream Resin behaviour where they are only reported (default true).
# PRISM_ENFORCE_STRONG_TOKENS=true
# Allow an empty PRISM_PROXY_TOKEN, i.e. proxy authentication off. Only for a
# deployment whose listeners stay on loopback (default false).
# PRISM_ALLOW_EMPTY_PROXY_TOKEN=false
# Allow the listeners above to bind a non-loopback address while the proxy token
# is empty (default false).
# PRISM_ALLOW_INSECURE_LISTEN=false
# Require a second factor for administrator accounts. An administrator without
# one still reaches the enrolment page (default false).
# PRISM_REQUIRE_ADMIN_TOTP=false
# Login/proxy failure limit per source IP on the proxy entry points; 0 disables
# it (default 30). The management API keeps its own limiter.
# PRISM_PROXY_AUTH_FAIL_LIMIT=30

# --- trusted proxies: client IPs and TLS termination ---
# CIDRs (or plain IPs) whose X-Forwarded-For is trusted when deriving the client
# IP for the failure limiter, and whose X-Forwarded-Proto: https is accepted as
# the transport the client really used. Prism has no TLS listener of its own, so
# a deployment that terminates TLS in a reverse proxy lists that proxy here:
# without it the request is plaintext HTTP from Prism's point of view and the
# session cookie (prism_session) is only issued on a loopback plaintext request.
# The rightmost value of X-Forwarded-Proto wins. Empty means "trust no proxy".
# Comma or semicolon separated.
# PRISM_TRUSTED_PROXIES=10.0.0.0/8,192.168.0.0/16

# --- SSRF and abuse guards ---
# Refuse loopback/private/link-local/CGNAT/reserved/metadata targets on every
# local direct dial path (reverse-proxy bypass, forward HTTP, CONNECT, SOCKS5);
# node-routed requests are unaffected (default true).
# PRISM_DIRECT_DENY_PRIVATE=true
# Destination ports refused on every local direct dial, comma separated. The
# default blocks the SMTP ports (25,465,587) so an open deployment is not an
# outbound mail relay; an empty value allows every port. Independent of
# PRISM_DIRECT_DENY_PRIVATE: turning that off does not reopen these ports.
# PRISM_BLOCKED_DESTINATION_PORTS=25,465,587
# Refuse a node whose own server names loopback, the LAN, a link-local address
# or a cloud metadata endpoint. The name is resolved when it is not a literal,
# so a public-looking hostname that answers with a private address
# (127.0.0.1.nip.io and friends) is refused too. On by default; set false if a
# deployment deliberately routes through a private node (a home server, a jump
# host).
# PRISM_DENY_PRIVATE_NODES=true
# Hosts and CIDRs the proxy never forwards through a node; comma separated
# (default empty).
# PRISM_PROXY_BYPASS=

# --- self-service registration ---
# off (default) | invite | open. `invite` requires an invite code and grants the
# plan the code carries; `open` attaches no plan. An empty or unknown value
# refuses to start.
# PRISM_REGISTRATION=off

# --- usage anomaly alerts ---
# Report an account that spends this share of its plan quota (0 < ratio <= 1)
# inside this many minutes, and keep the report for this many days (>= 1).
# Defaults: 0.3 / 60 / 90.
#
# The scanner runs once a minute and re-reads the settings on every pass, so a
# change made in the settings page is in force at the next scan - at most a
# minute later, not instantly, and not only after a restart. A variable that
# carries a value pins the setting at every start and overrides the persisted
# one; leave it out (or empty) to keep what the console saved. An out-of-range
# value refuses the start.
# PRISM_ALERT_USAGE_RATIO=0.3
# PRISM_ALERT_WINDOW_MINUTES=60
# PRISM_ALERT_RETENTION_DAYS=90

# --- probes and resource downloads ---
# PRISM_PROBE_CONCURRENCY=32
# PRISM_PROBE_TIMEOUT=15s
# PRISM_MAX_LATENCY_TABLE_ENTRIES=12
# PRISM_GEOIP_UPDATE_SCHEDULE=0 7 * * *
# Node egress probe target; empty keeps the persisted value or the shipped
# default (https://cloudflare.com/cdn-cgi/trace). Point it at a local endpoint
# in a fully offline deployment.
# PRISM_EGRESS_TRACE_URL=
# PRISM_RESOURCE_FETCH_TIMEOUT=30s
# Allow subscription/resource downloads to reach loopback and private addresses
# (default false: the SSRF guard is on).
# PRISM_RESOURCE_FETCH_ALLOW_PRIVATE=false
# Download ceiling after HTTP decompression, in bytes (default 32 MiB).
# PRISM_RESOURCE_FETCH_MAX_BYTES=33554432
# DNS upstreams for node name resolution, as a JSON array (default: the four
# entries below, in this order).
# PRISM_NODE_DNS_UPSTREAMS=["https://doh.pub/dns-query","https://dns.alidns.com/dns-query","tls://223.5.5.5?sni=dns.alidns.com","local"]

# --- outbound transport (defaults; tune only for an unusual link) ---
# PRISM_PROXY_TRANSPORT_MAX_IDLE_CONNS=1024
# PRISM_PROXY_TRANSPORT_MAX_IDLE_CONNS_PER_HOST=64
# PRISM_PROXY_TRANSPORT_IDLE_CONN_TIMEOUT=90s
# PRISM_PROXY_TRANSPORT_RESPONSE_HEADER_TIMEOUT=60s
# PRISM_PROXY_TRANSPORT_TLS_HANDSHAKE_TIMEOUT=10s
# PRISM_PROXY_TRANSPORT_DIAL_TIMEOUT=30s

# --- default platform settings (used by a platform that sets nothing itself) ---
# PRISM_DEFAULT_PLATFORM_STICKY_TTL=168h
# PRISM_DEFAULT_PLATFORM_REGEX_FILTERS=[]
# PRISM_DEFAULT_PLATFORM_REGION_FILTERS=[]
# PRISM_DEFAULT_PLATFORM_REVERSE_PROXY_MISS_ACTION=TREAT_AS_EMPTY
# PRISM_DEFAULT_PLATFORM_REVERSE_PROXY_EMPTY_ACCOUNT_BEHAVIOR=ACCOUNT_HEADER_RULE
# PRISM_DEFAULT_PLATFORM_REVERSE_PROXY_FIXED_ACCOUNT_HEADER=Authorization
# PRISM_DEFAULT_PLATFORM_ALLOCATION_POLICY=BALANCED

# --- request log ---
# PRISM_REQUEST_LOG_QUEUE_SIZE=8192
# PRISM_REQUEST_LOG_QUEUE_FLUSH_BATCH_SIZE=4096
# PRISM_REQUEST_LOG_QUEUE_FLUSH_INTERVAL=5m
# PRISM_REQUEST_LOG_DB_MAX_MB=512
# PRISM_REQUEST_LOG_DB_RETAIN_COUNT=2
# The queue size must be at least twice the flush batch size.

# --- metrics ---
# PRISM_METRIC_THROUGHPUT_INTERVAL_SECONDS=2
# PRISM_METRIC_THROUGHPUT_RETENTION_SECONDS=3600
# PRISM_METRIC_BUCKET_SECONDS=3600
# PRISM_METRIC_CONNECTIONS_INTERVAL_SECONDS=15
# PRISM_METRIC_CONNECTIONS_RETENTION_SECONDS=18000
# PRISM_METRIC_LEASES_INTERVAL_SECONDS=5
# PRISM_METRIC_LEASES_RETENTION_SECONDS=18000
# PRISM_METRIC_LATENCY_BIN_WIDTH_MS=100
# PRISM_METRIC_LATENCY_BIN_OVERFLOW_MS=3000

# --- exit quality ---
# Independent from health probes. Free public mode works without a key.
# PRISM_QUALITY_ENABLED=true
# PRISM_QUALITY_WORKERS=2
# PRISM_QUALITY_QUEUE_SIZE is deprecated and ignored: the provider queue is
# bounded by intel_node_workers. Setting it only logs a warning, and its value is
# no longer validated.
# Anonymous ProxyCheck: default local allowance 80/day (provider allows 100/day).
# With a free ProxyCheck key: default local allowance 900/day (provider allows 1000/day).
# PRISM_QUALITY_API_KEY=
# PRISM_QUALITY_DAILY_LIMIT=80
# Optional free AbuseIPDB account; separate allowance 900/day, recent 30-day reports.
# PRISM_ABUSEIPDB_API_KEY=
