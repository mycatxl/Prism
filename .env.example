# Copy only when you do not already have a private .env.
# Recommended: build Prism, then run ./bin/prism init to create random tokens.
PRISM_ADMIN_TOKEN=replace-with-your-random-admin-token
PRISM_PROXY_TOKEN=replace-with-your-random-proxy-token

# Primary listener: WebUI, API, HTTP forward proxy, reverse proxy, SOCKS5 and
# token-action all share it. Defaults are 127.0.0.1:2260.
PRISM_LISTEN_ADDRESS=127.0.0.1
PRISM_PORT=2260

# Optional independent management listener "host:port"; an empty value disables
# it. It only serves /ui, /api and /healthz, never a proxy protocol.
# PRISM_ADMIN_LISTEN=127.0.0.1:2261

# Relative to the directory from which Prism is started.
PRISM_STATE_DIR=./.local/state
PRISM_CACHE_DIR=./.local/cache
PRISM_LOG_DIR=./.local/logs
PRISM_PROBE_CONCURRENCY=32

# Security switches (all optional, defaults keep the upstream behaviour).
# CIDRs whose X-Forwarded-For is trusted when deriving the client IP for the
# management API login failure limit (10 failures/minute/IP, then 5 minutes of
# 429). Empty means "trust no proxy". Comma or semicolon separated.
# PRISM_TRUSTED_PROXIES=10.0.0.0/8,192.168.0.0/16
# Refuse loopback/private/link-local targets on the local direct reverse-proxy
# bypass path only (node-routed requests are unaffected).
# PRISM_DIRECT_DENY_PRIVATE=false
# Refuse a node whose own server names loopback, the LAN, a link-local address
# or a cloud metadata endpoint. The name is resolved when it is not a literal,
# so a public-looking hostname that answers with a private address
# (127.0.0.1.nip.io and friends) is refused too. Off by default: a deployment
# may deliberately route through a private node (a home server, a jump host).
# PRISM_DENY_PRIVATE_NODES=false
# Optional failure limit for the proxy entry points (HTTP forward proxy and
# CONNECT, reverse-proxy path token, SOCKS5 username/password); 0 disables it.
# The management API (/api/*) and the public /sub/{token} endpoint keep their
# own limiters, which this value does not change.
# PRISM_PROXY_AUTH_FAIL_LIMIT=0

# Optional resource download ceiling, after HTTP decompression (32 MiB).
# PRISM_RESOURCE_FETCH_MAX_BYTES=33554432

# Exit quality: independent from health probes. Free public mode works without a key.
# PRISM_QUALITY_ENABLED=true
# PRISM_QUALITY_WORKERS=2
# PRISM_QUALITY_QUEUE_SIZE=4096
# Anonymous ProxyCheck: default local allowance 80/day (provider allows 100/day).
# With a free ProxyCheck key: default local allowance 900/day (provider allows 1000/day).
# PRISM_QUALITY_API_KEY=
# PRISM_QUALITY_DAILY_LIMIT=80
# Optional free AbuseIPDB account; separate allowance 900/day, recent 30-day reports.
# PRISM_ABUSEIPDB_API_KEY=
