# Copy only when you do not already have a private .env.
# Recommended: build Prism, then run ./bin/prism init to create random tokens.
PRISM_ADMIN_TOKEN=replace-with-your-random-admin-token
PRISM_PROXY_TOKEN=replace-with-your-random-proxy-token

# Independent management and proxy listeners.
PRISM_UI_HOST=127.0.0.1
PRISM_UI_PORT=8080
PRISM_LISTEN_ADDRESS=127.0.0.1
PRISM_PORT=1080

# Relative to the directory from which Prism is started.
PRISM_STATE_DIR=./.local/state
PRISM_CACHE_DIR=./.local/cache
PRISM_LOG_DIR=./.local/logs
PRISM_PROBE_CONCURRENCY=32

# Optional resource download ceiling, after HTTP decompression (32 MiB).
# PRISM_RESOURCE_FETCH_MAX_BYTES=33554432

# Exit quality: independent from health probes. Free public mode works without a key.
# PRISM_QUALITY_ENABLED=true
# PRISM_QUALITY_WORKERS=2
# PRISM_QUALITY_QUEUE_SIZE=4096
# Anonymous ProxyCheck: default local allowance 80/day (provider allows 100/day).
# With a free ProxyCheck key: default local allowance 900/day (provider allows 1000/day).
# PRISM_QUALITY_API_KEY=
# PRISM_QUALITY_DAILY_LIMIT=80
# Optional free AbuseIPDB account; separate allowance 900/day, recent 30-day reports.
# PRISM_ABUSEIPDB_API_KEY=
